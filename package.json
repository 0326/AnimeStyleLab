{
  "name": "anime-style-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-styles.mjs && next dev -p 3326",
    "styles:build": "node scripts/build-styles.mjs",
    "styles:check": "node scripts/build-styles.mjs --check",
    "build": "node scripts/build-styles.mjs && next build --webpack",
    "start": "next start",
    "lint": "node scripts/build-styles.mjs --check && biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
